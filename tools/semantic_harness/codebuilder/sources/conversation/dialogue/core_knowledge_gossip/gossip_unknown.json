          {
            "id": "warm.02",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.gossip.unknown.warm.02"
            },
            "text": {
              "EN": "Wish I had something interesting to tell you.",
              "TL": "Sana may magandang balita akong maikwento sa'yo."
