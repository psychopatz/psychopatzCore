            "id": "warm.07",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.gossip.unknown.warm.07"
            },
            "text": {
              "EN": "I'll be sure to tell you if I hear anything new.",
              "TL": "Tiyak na sasabihin ko sa'yo kapag may narinig akong bago."
