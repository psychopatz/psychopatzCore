          {
            "id": "neutral.07",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.gossip.unknown.neutral.07"
            },
            "text": {
              "EN": "Word travels slow. Haven't heard anything.",
              "TL": "Mabagal kumalat ang balita. Wala akong narinig."
            }
          },
          {
            "id": "neutral.08",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.gossip.unknown.neutral.08"
            },
            "text": {
              "EN": "I haven't caught any talk recently.",
              "TL": "Wala akong nasagap na usapan kamakailan."
            }
          },
          {
            "id": "neutral.09",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.gossip.unknown.neutral.09"
            },
            "text": {
              "EN": "No gossip on my radar at the moment.",
              "TL": "Walang tsismis sa akin sa ngayon."
            }
          },
          {
            "id": "neutral.10",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.gossip.unknown.neutral.10"
            },
            "text": {
              "EN": "Haven't heard much of anything lately.",
              "TL": "Halos wala akong narinig na anuman kamakailan."
            }
          }
