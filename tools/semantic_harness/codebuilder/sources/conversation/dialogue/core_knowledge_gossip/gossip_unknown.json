          {
            "id": "warm.08",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.gossip.unknown.warm.08"
            },
            "text": {
              "EN": "Quiet days out there. No rumors to report.",
              "TL": "Tahimik ang mga araw sa labas. Walang maiuulat na tsismis."
