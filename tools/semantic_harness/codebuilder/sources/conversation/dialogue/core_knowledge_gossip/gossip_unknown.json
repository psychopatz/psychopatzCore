          {
            "id": "neutral.04",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.gossip.unknown.neutral.04"
            },
            "text": {
              "EN": "Haven't picked up any word from other survivors.",
              "TL": "Walang nasagap na balita mula sa ibang survivor."
