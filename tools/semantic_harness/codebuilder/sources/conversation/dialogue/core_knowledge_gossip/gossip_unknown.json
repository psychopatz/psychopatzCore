          },
          {
            "id": "warm.03",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.gossip.unknown.warm.03"
            },
            "text": {
              "EN": "Haven't heard any rumors, but I'll let you know.",
              "TL": "Walang narinig na tsismis, pero sasabihan kita."
            }
          },
          {
            "id": "warm.04",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.gossip.unknown.warm.04"
            },
            "text": {
              "EN": "All quiet on my side, but I'll keep an ear out.",
              "TL": "Tahimik sa panig ko, pero makikinig ako."
            }
          },
          {
            "id": "warm.05",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.gossip.unknown.warm.05"
            },
            "text": {
              "EN": "Sorry, no fresh news today, my friend.",
              "TL": "Pasensya na, walang bagong balita ngayon, kaibigan."
            }
          },
          {
            "id": "warm.06",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.gossip.unknown.warm.06"
            },
            "text": {
              "EN": "Nothing reaching my ears lately. Hope all is well.",
              "TL": "Walang dumarating sa akin kamakailan. Sana ayos ka lang."
            }
