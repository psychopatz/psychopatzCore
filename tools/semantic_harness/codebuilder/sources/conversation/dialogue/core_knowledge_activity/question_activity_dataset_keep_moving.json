        "variants": [
          {
            "id": "warm.01",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.dataset.keep_moving.warm.01"
            },
            "text": {
              "EN": "Let's keep moving together, friend. We'll find safety.",
              "TL": "Magpatuloy tayong maglakad nang magkasama, kaibigan. Makakahanap tayo ng kaligtasan."
            }
          },
          {
            "id": "warm.02",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.dataset.keep_moving.warm.02"
            },
            "text": {
              "EN": "We should keep going. I'll stay right by your side.",
              "TL": "Dapat tayong magpatuloy. Mananatili ako sa tabi mo."
            }
          },
          {
            "id": "warm.03",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.dataset.keep_moving.warm.03"
            },
            "text": {
              "EN": "Let's keep our feet moving. A warm fire awaits us eventually.",
              "TL": "Igalaw natin ang mga paa natin. May naghihintay na maaliwalas na apoy sa atin sa dulo."
            }
          },
          {
            "id": "warm.04",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.dataset.keep_moving.warm.04"
            },
            "text": {
              "EN": "Keep up the good pace. We're doing fine.",
              "TL": "Ipagpatuloy ang magandang bilis. Maayos ang lagay natin."
            }
          },
          {
            "id": "warm.05",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.dataset.keep_moving.warm.05"
            },
            "text": {
              "EN": "Let's keep walking together. We're safer on the move.",
              "TL": "Sabay tayong maglakad. Mas ligtas tayo habang kumikilos."
            }
          },
          {
            "id": "warm.06",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.dataset.keep_moving.warm.06"
            },
            "text": {
              "EN": "We'll get through this path. Just keep moving with me.",
              "TL": "Malalampasan natin ang landas na 'to. Sumabay ka lang sa akin."
            }
          },
          {
            "id": "warm.07",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.dataset.keep_moving.warm.07"
            },
            "text": {
              "EN": "Let's keep going, one step at a time.",
              "TL": "Magpatuloy tayo, bawat hakbang."
            }
          },
          {
            "id": "warm.08",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.dataset.keep_moving.warm.08"
            },
            "text": {
              "EN": "I'm with you. Let's keep walking until we find shelter.",
              "TL": "Kasama mo ako. Tuloy lang sa paglakad hanggang makahanap ng silungan."
            }
          },
          {
            "id": "warm.09",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.dataset.keep_moving.warm.09"
            },
            "text": {
              "EN": "Keep moving forward. We've got this.",
              "TL": "Tuloy sa pagsulong. Kaya natin 'to."
            }
          },
          {
            "id": "warm.10",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.dataset.keep_moving.warm.10"
            },
            "text": {
              "EN": "Let's keep our spirits up and keep walking.",
