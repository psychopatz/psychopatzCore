      "response": {
        "act": "KNOWLEDGE_RESPONSE",
        "variants": [
          {
            "id": "neutral.01",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.dataset.keep_moving.neutral.01"
            },
            "text": {
              "EN": "We should keep moving. It's not safe to linger.",
              "TL": "Dapat tayong magpatuloy sa paglakad. Hindi ligtas magtagal."
            }
          },
          {
            "id": "neutral.02",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.dataset.keep_moving.neutral.02"
            },
            "text": {
              "EN": "Staying mobile is our best option right now.",
              "TL": "Ang pananatiling gumagalaw ang pinakamagandang opsyon natin ngayon."
            }
          },
          {
            "id": "neutral.03",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.dataset.keep_moving.neutral.03"
            },
            "text": {
              "EN": "We need to continue forward and find shelter.",
              "TL": "Kailangan nating magpatuloy pasulong at maghanap ng masisilungan."
            }
          },
          {
            "id": "neutral.04",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.dataset.keep_moving.neutral.04"
            },
            "text": {
              "EN": "It's best if we keep moving down this route.",
              "TL": "Pinakamabuti kung magpapatuloy tayo sa rutang ito."
            }
          },
          {
            "id": "neutral.05",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.dataset.keep_moving.neutral.05"
            },
            "text": {
              "EN": "Let's keep the pace. We have ground to cover.",
              "TL": "Panatilihin natin ang bilis. Marami pa tayong lalakarin."
            }
          },
          {
            "id": "neutral.06",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.dataset.keep_moving.neutral.06"
            },
            "text": {
              "EN": "We shouldn't remain stationary for too long.",
              "TL": "Hindi tayo dapat manatiling nakatigil nang matagal."
            }
          },
          {
            "id": "neutral.07",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.dataset.keep_moving.neutral.07"
            },
            "text": {
              "EN": "Keep walking. We need to reach our objective.",
              "TL": "Magpatuloy sa paglakad. Kailangan nating marating ang layunin natin."
            }
          },
          {
            "id": "neutral.08",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.dataset.keep_moving.neutral.08"
            },
            "text": {
              "EN": "Moving along is the safest strategy right now.",
              "TL": "Ang pag-usad ang pinakaligtas na stratehiya ngayon."
            }
          },
          {
            "id": "neutral.09",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.dataset.keep_moving.neutral.09"
            },
            "text": {
              "EN": "Let's continue on our way.",
              "TL": "Magpatuloy tayo sa ating daan."
            }
          },
          {
            "id": "neutral.10",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.dataset.keep_moving.neutral.10"
            },
            "text": {
              "EN": "We should maintain our momentum and keep moving.",
              "TL": "Dapat nating panatilihin ang ating bwelo at magpatuloy sa paglakad."
            }
          }
        ]
      },
      "namespace": "semantic.question.activity.dataset.keep_moving"
