      "response": {
        "act": "KNOWLEDGE_RESPONSE",
        "variants": [
          {
            "id": "warm.01",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.fishing.warm.01"
            },
            "text": {
              "EN": "Fishing by the water sounds peaceful right now.",
              "TL": "Mukhang mapayapa ang pangingisda sa tabi ng tubig ngayon."
            }
          },
          {
            "id": "warm.02",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.fishing.warm.02"
            },
            "text": {
              "EN": "I'd love to catch some fresh fish for us to cook.",
              "TL": "Gusto kong makahuli ng sariwang isda para lutuin natin."
            }
          },
          {
            "id": "warm.03",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.fishing.warm.03"
            },
            "text": {
              "EN": "A nice fresh catch would make a wonderful meal for us.",
              "TL": "Ang sariwang huli ay magiging napakagandang salu-salo para sa atin."
            }
          },
          {
            "id": "warm.04",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.fishing.warm.04"
            },
            "text": {
              "EN": "It feels good to take a moment by the water and fish.",
              "TL": "Masarap magpahinga sandali sa tabi ng tubig at mangisda."
            }
          },
          {
            "id": "warm.05",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.fishing.warm.05"
            },
            "text": {
              "EN": "Let's see if we can catch something tasty together.",
              "TL": "Tignan natin kung makakahuli tayo ng masarap nang magkasama."
            }
          },
          {
            "id": "warm.06",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.fishing.warm.06"
            },
            "text": {
              "EN": "Fishing reminds me of quieter times. Let's cast a line.",
              "TL": "Naaalala ko ang mga tahimik na panahon sa pangingisda. Maghagis tayo."
            }
          },
          {
            "id": "warm.07",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.fishing.warm.07"
            },
            "text": {
              "EN": "A warm fire and fresh fish would do wonders for our mood.",
              "TL": "Ang maaliwalas na apoy at sariwang isda ay magpapagaan ng loob natin."
            }
          },
          {
            "id": "warm.08",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.fishing.warm.08"
            },
            "text": {
              "EN": "I'll keep watch while you fish, or we can take turns.",
              "TL": "Babantayan kita habang nangingisda ka, o magsalitan tayo."
            }
          },
          {
            "id": "warm.09",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.fishing.warm.09"
            },
            "text": {
              "EN": "Fresh catch would be a real treat for both of us.",
              "TL": "Tunay na pabuya para sa atin ang sariwang huli."
            }
          },
          {
            "id": "warm.10",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.activity.fishing.warm.10"
            },
            "text": {
              "EN": "Let's catch a good meal and share it tonight.",
              "TL": "Manghuli tayo ng masarap na pagkain at magsalu-salo ngayong gabi."
            }
          }
        ]
      },
