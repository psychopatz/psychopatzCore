        "style": "neutral"
      },
      "response": {
        "act": "KNOWLEDGE_RESPONSE",
        "variants": [
          {
            "id": "neutral.01",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.fishing.neutral.01"
            },
            "text": {
              "EN": "Fishing is a solid way to secure fresh food.",
              "TL": "Magandang paraan ang pangingisda para makakuha ng sariwang pagkain."
            }
          },
          {
            "id": "neutral.02",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.fishing.neutral.02"
            },
            "text": {
              "EN": "We can catch fish here if we have rod and bait.",
              "TL": "Makakahuli tayo ng isda rito kung may pamingwit at pain."
            }
          },
          {
            "id": "neutral.03",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.fishing.neutral.03"
            },
            "text": {
              "EN": "The water looks promising for catching dinner.",
              "TL": "Mukhang maganda ang tubig para makahuli ng hapunan."
            }
          },
          {
            "id": "neutral.04",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.fishing.neutral.04"
            },
            "text": {
              "EN": "Fishing requires patience, but it provides calories.",
              "TL": "Kailangan ng pasensya sa pangingisda, pero nagbibigay ito ng lakas."
            }
          },
          {
            "id": "neutral.05",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.fishing.neutral.05"
            },
            "text": {
              "EN": "A good spot to cast a line and get some food.",
              "TL": "Magandang lugar para maghulog ng pamingwit at kumuha ng pagkain."
            }
          },
          {
            "id": "neutral.06",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.fishing.neutral.06"
            },
            "text": {
              "EN": "We should try fishing if our rations are running low.",
              "TL": "Dapat nating subukan ang pangingisda kung paubos na ang rasyon."
            }
          },
          {
            "id": "neutral.07",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.fishing.neutral.07"
            },
            "text": {
              "EN": "Fish are clean protein out here in the wild.",
              "TL": "Malinis na protina ang isda rito sa labas."
            }
          },
          {
            "id": "neutral.08",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.fishing.neutral.08"
            },
            "text": {
              "EN": "Check the line and bait. We could catch something good.",
              "TL": "Tignan ang pisi at pain. Baka makahuli tayo ng maganda."
            }
          },
          {
            "id": "neutral.09",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.fishing.neutral.09"
            },
            "text": {
              "EN": "Fishing by the river is a viable survival task.",
              "TL": "Mabisang gawaing kaligtasan ang pangingisda sa ilog."
            }
          },
          {
            "id": "neutral.10",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.activity.fishing.neutral.10"
            },
            "text": {
              "EN": "We can cast a line here while the area is clear.",
              "TL": "Pwede tayong maghagis ng pamingwit dito habang malinis ang lugar."
            }
          }
        ]
      },
      "namespace": "semantic.question.activity.fishing"
    },
