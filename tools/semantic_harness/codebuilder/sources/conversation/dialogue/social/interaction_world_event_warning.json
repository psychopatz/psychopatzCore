      "metadata": {
        "category": "psychopatzcore:world_event",
        "sourceSurface": "content/social/interaction/world_event/warning.json",
        "responseTemplateID": "semantic.interaction.world_event.warning",
        "style": "neutral"
      },
      "response": {
        "act": "WORLD_WARNING",
        "variants": [
          {
            "id": "neutral.01",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning.neutral.01"
            },
            "text": {
              "EN": "Heads up. Something's wrong out there.",
              "TL": "Mag-ingat. May mali sa labas."
            }
          },
          {
            "id": "neutral.02",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning.neutral.02"
            },
            "text": {
              "EN": "Look alive. The situation outside is shifting.",
              "TL": "Maging alerto. Nagbabago ang sitwasyon sa labas."
            }
          },
          {
            "id": "neutral.03",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning.neutral.03"
            },
            "text": {
              "EN": "Pay attention. We have unexpected movement outside.",
              "TL": "Makinig ka. May di-inaasahang galaw sa labas."
            }
          },
          {
            "id": "neutral.04",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning.neutral.04"
            },
            "text": {
              "EN": "Warning. Something big is happening nearby.",
              "TL": "Babala. May malaking nangyayari sa malapit."
            }
          },
          {
            "id": "neutral.05",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning.neutral.05"
            },
            "text": {
              "EN": "Heads up, everyone. Check your gear.",
              "TL": "Mag-ingat ang lahat. Suriin ang mga gamit niyo."
            }
          },
          {
            "id": "neutral.06",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning.neutral.06"
            },
            "text": {
              "EN": "Listen close. An event is unfolding out there.",
              "TL": "Makinig nang mabuti. May kaganapan sa labas."
            }
          },
          {
            "id": "neutral.07",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning.neutral.07"
            },
            "text": {
              "EN": "Alert. We need to be ready for trouble.",
              "TL": "Alerto. Kailangan nating maging handa sa gulo."
            }
          },
          {
            "id": "neutral.08",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning.neutral.08"
            },
            "text": {
              "EN": "Keep your eyes open. That sound wasn't normal.",
              "TL": "Buksan ang mga mata. Hindi karaniwan ang tunog na 'yon."
            }
          },
          {
            "id": "neutral.09",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning.neutral.09"
            },
            "text": {
              "EN": "Stay sharp. The perimeter is showing activity.",
              "TL": "Maging alerto. May aktibidad sa paligid."
            }
          },
          {
            "id": "neutral.10",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning.neutral.10"
            },
            "text": {
              "EN": "Heads up. Let's not get caught unprepared.",
              "TL": "Mag-ingat. Huwag tayong mahuling walang paghahanda."
            }
          }
        ]
      },
      "namespace": "semantic.interaction.world_event.warning"
    },
    {
      "kind": "dialogue",
      "id": "warm",
      "owner": "PsychopatzCore",
      "participants": {
        "speaker": [
          "participant"
        ],
        "addressee": [
          "participant"
        ]
      },
      "metadata": {
        "category": "psychopatzcore:world_event",
        "sourceSurface": "content/social/interaction/world_event/warning.json",
        "responseTemplateID": "semantic.interaction.world_event.warning",
        "style": "warm"
      },
      "response": {
        "act": "WORLD_WARNING",
        "variants": [
          {
            "id": "warm.01",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning.warm.01"
            },
            "text": {
              "EN": "Stay close. Something's wrong out there.",
              "TL": "Manatili kang malapit. May mali sa labas."
            }
          },
          {
            "id": "warm.02",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning.warm.02"
            },
            "text": {
              "EN": "Stick by me, friend. We have trouble brewing outside.",
              "TL": "Dumikit ka sa akin, kaibigan. May namumuong gulo sa labas."
            }
          },
          {
            "id": "warm.03",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning.warm.03"
            },
            "text": {
              "EN": "Don't wander off. Something bad is moving out there.",
              "TL": "Huwag kang lalayo. May masamang gumagalaw sa labas."
            }
          },
          {
            "id": "warm.04",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning.warm.04"
            },
            "text": {
              "EN": "Keep close and stay low. I'll protect you.",
              "TL": "Manatiling malapit at yumuko. Poprotektahan kita."
            }
          },
          {
            "id": "warm.05",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning.warm.05"
            },
            "text": {
              "EN": "Hey, stay behind me until we know what that was.",
              "TL": "Huy, manatili ka sa likod ko hanggang malaman natin 'yon."
            }
          },
          {
            "id": "warm.06",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning.warm.06"
            },
            "text": {
              "EN": "Careful, everyone! Let's look out for one another.",
              "TL": "Mag-ingat ang lahat! Magbantayan tayo sa isa't isa."
            }
          },
          {
            "id": "warm.07",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning.warm.07"
            },
            "text": {
              "EN": "Hold on to each other. Danger is nearby.",
              "TL": "Kumapit sa isa't isa. Malapit lang ang panganib."
            }
          },
          {
            "id": "warm.08",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning.warm.08"
            },
            "text": {
              "EN": "Stay safe by my side. Trouble is coming.",
              "TL": "Manatiling ligtas sa tabi ko. Parating ang panganib."
            }
          },
          {
            "id": "warm.09",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning.warm.09"
            },
            "text": {
              "EN": "Heads up, partner. Whatever happens, we stick together.",
              "TL": "Mag-ingat, kasama. Anuman ang mangyari, sama-sama tayo."
            }
          },
          {
            "id": "warm.10",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning.warm.10"
            },
            "text": {
              "EN": "Keep close. I don't want anyone getting separated.",
              "TL": "Dumikit ka. Ayokong may mahiwalay sa atin."
            }
          }
        ]
      },
      "namespace": "semantic.interaction.world_event.warning"
    },
