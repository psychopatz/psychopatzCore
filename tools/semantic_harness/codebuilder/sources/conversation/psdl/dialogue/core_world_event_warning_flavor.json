            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning_flavor.warm.01"
            },
            "text": {
              "EN": "The NPC motions for the others to stay close.",
              "TL": "Sinenyasan ng NPC ang iba na manatiling malapit."
            }
          },
          {
            "id": "warm.02",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning_flavor.warm.02"
            },
            "text": {
              "EN": "The NPC places a protective hand out, urging allies to gather.",
              "TL": "Inilahad ng NPC ang protektibong kamay, pinapalapit ang mga kasama."
            }
          },
          {
            "id": "warm.03",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning_flavor.warm.03"
            },
            "text": {
              "EN": "The NPC steps forward to shield their companions from view.",
              "TL": "Humakbang pasulong ang NPC upang harangan sa paningin ang mga kasama."
            }
          },
          {
            "id": "warm.04",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning_flavor.warm.04"
            },
            "text": {
              "EN": "The NPC gives an urgent, reassuring glance to their partners.",
              "TL": "Nagbigay ng mabilis at nakapagpapanatag na tingin ang NPC sa mga kasama."
            }
          },
          {
            "id": "warm.05",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning_flavor.warm.05"
            },
            "text": {
              "EN": "The NPC whispers a quiet encouragement while staying watchful.",
              "TL": "Bumulong ng pampalakas ng loob ang NPC habang nananatiling mapagmatyag."
            }
          },
          {
            "id": "warm.06",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning_flavor.warm.06"
            },
            "text": {
              "EN": "The NPC gestures for the group to huddle together safely.",
              "TL": "Nagsenyas ang NPC sa grupo na magsama-sama nang ligtas."
            }
          },
          {
            "id": "warm.07",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning_flavor.warm.07"
            },
            "text": {
              "EN": "The NPC keeps one eye on the threat and one on their friends.",
              "TL": "Bantay ng NPC ang banta habang tinitingnan din ang mga kaibigan."
            }
          },
          {
            "id": "warm.08",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning_flavor.warm.08"
            },
            "text": {
              "EN": "The NPC gently pulls their ally behind solid cover.",
              "TL": "Marahang hinila ng NPC ang kasama sa likod ng matibay na kublihan."
            }
          },
          {
            "id": "warm.09",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning_flavor.warm.09"
            },
            "text": {
              "EN": "The NPC nods determinedly to protect those nearby.",
              "TL": "Determinado at matatag na tumango ang NPC para protektahan ang iba."
            }
          },
          {
            "id": "warm.10",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.interaction.world_event.warning_flavor.warm.10"
            },
            "text": {
              "EN": "The NPC stays tightly flanked with their companions.",
              "TL": "Nanatiling nakadikit ang NPC sa tabi ng mga kasama."
            }
          }
        ]
      }
