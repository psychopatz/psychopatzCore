      "metadata": {
        "category": "psychopatzcore:world_event",
        "sourceSurface": "content/social/interaction/world_event/warning_flavor.json",
        "responseTemplateID": "semantic.interaction.world_event.warning_flavor",
        "style": "neutral"
      },
      "response": {
        "act": "AMBIENT_FLAVOR",
        "variants": [
          {
            "id": "neutral.01",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning_flavor.neutral.01"
            },
            "text": {
              "EN": "The NPC snaps to attention and scans the area.",
              "TL": "Biglang naging alerto ang NPC at sinuri ang paligid."
            }
          },
          {
            "id": "neutral.02",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning_flavor.neutral.02"
            },
            "text": {
              "EN": "The NPC pauses and listens intently to distant noise.",
              "TL": "Huminto ang NPC at taimtim na nakinig sa malayong ingay."
            }
          },
          {
            "id": "neutral.03",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning_flavor.neutral.03"
            },
            "text": {
              "EN": "The NPC raises a hand to signal sudden awareness.",
              "TL": "Itinaas ng NPC ang kamay bilang senyas ng biglaang pagka-alerto."
            }
          },
          {
            "id": "neutral.04",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning_flavor.neutral.04"
            },
            "text": {
              "EN": "The NPC turns sharply toward the source of the disturbance.",
              "TL": "Mabilis na lumingon ang NPC sa pinagmulan ng kaguluhan."
            }
          },
          {
            "id": "neutral.05",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning_flavor.neutral.05"
            },
            "text": {
              "EN": "A tense hush falls as the NPC monitors the perimeter.",
              "TL": "Isang tensiyonadong katahimikan ang bumalot habang nagbabantay ang NPC."
            }
          },
          {
            "id": "neutral.06",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning_flavor.neutral.06"
            },
            "text": {
              "EN": "The NPC shifts their stance, ready to react.",
              "TL": "Nagbago ng tindig ang NPC, handang rumesponde."
            }
          },
          {
            "id": "neutral.07",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning_flavor.neutral.07"
            },
            "text": {
              "EN": "The NPC points toward the horizon with furrowed brows.",
              "TL": "Itinuro ng NPC ang abot-tanaw habang nakakunot ang noo."
            }
          },
          {
            "id": "neutral.08",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning_flavor.neutral.08"
            },
            "text": {
              "EN": "The NPC squints into the distance, assessing the threat.",
              "TL": "Nanliit ang mata ng NPC sa malayo, tinitimbang ang banta."
            }
          },
          {
            "id": "neutral.09",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning_flavor.neutral.09"
            },
            "text": {
              "EN": "The NPC signals caution to everyone nearby.",
              "TL": "Nagsenyas ng pag-iingat ang NPC sa lahat ng nasa malapit."
            }
          },
          {
            "id": "neutral.10",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.interaction.world_event.warning_flavor.neutral.10"
            },
            "text": {
              "EN": "The NPC's posture straightens instantly at the sound.",
              "TL": "Agad na naituwid ang tindig ng NPC nang marinig ang tunog."
            }
          }
        ]
      }
    },
