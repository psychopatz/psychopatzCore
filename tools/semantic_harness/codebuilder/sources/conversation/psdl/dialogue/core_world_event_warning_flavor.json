            "metadata": {
              "style": "terse",
              "textKey": "semantic.interaction.world_event.warning_flavor.terse.08"
            },
            "text": {
              "EN": "A quick wave commands cover.",
              "TL": "Isang mabilis na kumpas ang nag-utos na magtago."
