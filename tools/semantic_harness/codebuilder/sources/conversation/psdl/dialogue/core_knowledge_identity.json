        "style": "neutral"
      },
      "response": {
        "act": "KNOWLEDGE_RESPONSE",
        "variants": [
          {
            "id": "neutral.01",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.identity.neutral.01"
            },
            "text": {
              "EN": "I'm just a survivor trying to make it through.",
              "TL": "Isa lang akong survivor na sumusubok makaraos."
            }
          },
          {
            "id": "neutral.02",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.identity.neutral.02"
            },
            "text": {
              "EN": "I used to be someone else before all this fell apart.",
              "TL": "Ibang tao ako noon bago nagkawasak-wasak ang lahat."
            }
          },
          {
            "id": "neutral.03",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.identity.neutral.03"
            },
            "text": {
              "EN": "Just another person looking for shelter and food.",
              "TL": "Isa lang akong tao na naghahanap ng masisilungan at makakain."
            }
          },
          {
            "id": "neutral.04",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.identity.neutral.04"
            },
            "text": {
              "EN": "I'm surviving day by day, same as you.",
              "TL": "Nabubuhay ako araw-araw, tulad mo rin."
            }
          },
          {
            "id": "neutral.05",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.identity.neutral.05"
            },
            "text": {
              "EN": "Not much to tell. Just doing what it takes to live.",
              "TL": "Walang gaanong maikukwento. Ginagawa lang ang kailangan para mabuhay."
            }
          },
          {
            "id": "neutral.06",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.identity.neutral.06"
            },
            "text": {
              "EN": "I'm a survivor out here in the county.",
              "TL": "Isa akong survivor dito sa lugar."
            }
          },
          {
            "id": "neutral.07",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.identity.neutral.07"
            },
            "text": {
              "EN": "Just someone trying to stay one step ahead of the dead.",
              "TL": "Isang tao lang na sumusubok mauna sa mga patay."
            }
          },
          {
            "id": "neutral.08",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.identity.neutral.08"
            },
            "text": {
              "EN": "I've been on the road since the outbreak started.",
              "TL": "Nasa kalsada na ako simula no'ng magsimula ang outbreak."
            }
          },
          {
            "id": "neutral.09",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.identity.neutral.09"
            },
            "text": {
              "EN": "Simple survivor. That's about the extent of it.",
              "TL": "Simpleng survivor lang. Hanggang doon lang."
            }
          },
          {
            "id": "neutral.10",
            "metadata": {
              "style": "neutral",
              "textKey": "semantic.question.identity.neutral.10"
            },
            "text": {
              "EN": "Trying to stay breathing, same as everyone else.",
              "TL": "Sinusubukang manatiling humihinga, tulad ng iba."
            }
          }
        ]
      }
    },
