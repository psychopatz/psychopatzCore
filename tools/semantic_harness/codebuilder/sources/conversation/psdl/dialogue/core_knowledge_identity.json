        "style": "warm"
      },
      "response": {
        "act": "KNOWLEDGE_RESPONSE",
        "variants": [
          {
            "id": "warm.01",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.identity.warm.01"
            },
            "text": {
              "EN": "I'm glad to share this road with you, friend.",
              "TL": "Masaya akong kasama ka sa kalsadang 'to, kaibigan."
            }
          },
          {
            "id": "warm.02",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.identity.warm.02"
            },
            "text": {
              "EN": "Just an old soul trying to do some good in a ruined world.",
              "TL": "Isang simpleng tao na sumusubok gumawa ng kabutihan sa sirang mundong 'to."
            }
          },
          {
            "id": "warm.03",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.identity.warm.03"
            },
            "text": {
              "EN": "I'm someone who values good company out here.",
              "TL": "Isa akong taong nagpapahalaga sa mabuting kasama rito."
            }
          },
          {
            "id": "warm.04",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.identity.warm.04"
            },
            "text": {
              "EN": "Call me a friend. We're in this struggle together.",
              "TL": "Tawagin mo akong kaibigan. Magkasama tayo sa laban na 'to."
            }
          },
          {
            "id": "warm.05",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.identity.warm.05"
            },
            "text": {
              "EN": "I used to have a regular life, but now I have people I care about.",
              "TL": "May normal akong buhay noon, pero ngayon may mga taong mahalaga na sa akin."
            }
          },
          {
            "id": "warm.06",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.identity.warm.06"
            },
            "text": {
              "EN": "Just someone grateful to have found you in all this chaos.",
              "TL": "Nagpapasalamat lang na nakatagpo kita sa gitna ng kaguluhang ito."
            }
          },
          {
            "id": "warm.07",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.identity.warm.07"
            },
            "text": {
              "EN": "A friend and ally. That's who I want to be for you.",
              "TL": "Isang kaibigan at kakampi. 'Yan ang nais kong maging para sa'yo."
            }
          },
          {
            "id": "warm.08",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.identity.warm.08"
            },
            "text": {
              "EN": "I'm just happy to be standing here talking to you.",
              "TL": "Masaya lang ako na nakatayo rito at nakakausap ka."
            }
          },
          {
            "id": "warm.09",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.identity.warm.09"
            },
            "text": {
              "EN": "We're partners out here. That's all that matters to me.",
              "TL": "Magkasosyo tayo rito. 'Yon lang ang mahalaga sa akin."
            }
          },
          {
            "id": "warm.10",
            "metadata": {
              "style": "warm",
              "textKey": "semantic.question.identity.warm.10"
            },
            "text": {
              "EN": "A loyal companion on the long road ahead.",
              "TL": "Isang tapat na kasama sa mahabang daan sa unahan."
            }
          }
        ]
      }
    },
