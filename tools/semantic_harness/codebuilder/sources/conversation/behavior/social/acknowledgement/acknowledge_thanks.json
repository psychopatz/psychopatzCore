{
  "schema": "psychopatz.convo-engine.v1",
  "id": "behavior.acknowledge_thanks",
  "act": "ACKNOWLEDGE_THANKS",
  "baseRelevance": 0.55,
  "mode": "one_shot",
  "modifiers": [
    {
      "delta": 0.1,
      "reason": "sociable_acknowledgement",
      "when": "actor.disposition.sociability >= 0.65"
    }
  ],
  "outputs": {
    "speech": {
      "contentTemplateID": "social.acknowledged",
      "dialogueAct": "ACKNOWLEDGE"
    }
  },
  "requiredCapabilities": [
    "speech"
  ],
  "stimuli": [
    "HUMAN_UTTERANCE",
    "NPC_SEMANTIC_ACT"
  ],
  "when": "stimulus.semantic.intent == \"THANK\" && pragmatic.contextualAdmission.admitted && pragmatic.contextualAdmission.selected.relation == \"gratitude\"",
  "metadata": {
    "compositionHooksNotApplicableReason": "Domain-agnostic gratitude acknowledgement strategy"
  }
}
