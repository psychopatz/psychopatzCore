{
  "schema": "psychopatz.convo-engine.v1",
  "profile": "social_behavior",
  "id": "behavior.warn",
  "act": "WARN",
  "baseRelevance": 0.65,
  "modifiers": [
    {
      "delta": 0.12,
      "reason": "low_approval",
      "when": "relationship.approval < 0"
    },
    {
      "delta": 0.08,
      "reason": "confident",
      "when": "actor.disposition.confidence >= 0.6"
    }
  ],
  "outputs": {
    "speech": {
      "contentTemplateID": "social.hostile_boundary",
      "dialogueAct": "BOUNDARY_WARNING"
    }
  },
  "when": "stimulus.semantic.speechAct in [\"INSULT\", \"HOSTILE_REMARK\", \"THREATEN\"]",
  "topics": [
    {
      "id": "conflict",
      "domain": "social"
    }
  ],
  "domains": [
    {
      "domain": "social",
      "owner": "PsychopatzCore"
    }
  ]
}
