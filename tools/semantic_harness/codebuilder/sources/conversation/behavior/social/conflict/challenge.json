{
  "schema": "psychopatz.convo-engine.v1",
  "profile": "social_behavior",
  "id": "behavior.challenge",
  "act": "CHALLENGE",
  "baseRelevance": 0.5,
  "modifiers": [
    {
      "delta": 0.12,
      "reason": "confidence_supports_challenge",
      "when": "actor.disposition.confidence >= 0.55"
    }
  ],
  "outputs": {
    "speech": {
      "contentTemplateID": "interaction.first_contact.challenge",
      "dialogueAct": "CHALLENGE"
    }
  },
  "when": "stimulus.semantic.intent in [\"GREET\", \"GOSSIP\"]",
  "topics": [
    {
      "id": "conflict",
      "domain": "social"
    }
  ],
  "domains": [
    {
      "domain": "social",
      "owner": "PsychopatzCore"
    }
  ]
}
