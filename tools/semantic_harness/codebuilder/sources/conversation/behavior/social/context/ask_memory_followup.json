{
  "schema": "psychopatz.psdl.v2",
  "id": "behavior.ask_memory_followup",
  "act": "ASK_MEMORY_FOLLOWUP",
  "baseRelevance": 0.45,
  "mode": "one_shot",
  "modifiers": [
    {
      "delta": 0.25,
      "reason": "sociability_favors_followup",
      "when": "actor.disposition.sociability >= 0.6"
    },
    {
      "delta": 0.1,
      "reason": "familiarity_favors_followup",
      "when": "relationship.familiarity >= 2"
    }
  ],
  "outputs": {
    "speech": {
      "contentTemplateID": "interaction.memory.followup",
      "dialogueAct": "ASK_FOLLOWUP"
    }
  },
  "requiredCapabilities": [
    "speech"
  ],
  "stimuli": [
    "NPC_SEMANTIC_ACT"
  ],
  "when": "stimulus.semantic.intent == \"SHARE_MEMORY\""
}
