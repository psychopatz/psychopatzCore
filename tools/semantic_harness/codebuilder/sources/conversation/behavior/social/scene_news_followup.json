{
  "schema": "psychopatz.psdl.v2",
  "id": "behavior.scene_news_followup",
  "act": "ASK_NEWS_FOLLOWUP",
  "baseRelevance": 0.45,
  "continuation": {
    "intent": "ASK_NEWS_FOLLOWUP",
    "mode": "emit",
    "speechAct": "ASK_FOLLOWUP",
    "target": "source"
  },
  "mode": "one_shot",
  "modifiers": [
    {
      "delta": 0.25,
      "reason": "sociability_favors_news_followup",
      "when": "actor.disposition.sociability >= 0.6"
    }
  ],
  "outputs": {
    "speech": {
      "contentTemplateID": "interaction.memory.followup",
      "dialogueAct": "ASK_FOLLOWUP"
    }
  },
  "requiredCapabilities": [
    "speech"
  ],
  "stimuli": [
    "NPC_SEMANTIC_ACT"
  ],
  "when": "stimulus.semantic.intent == \"SHARE_GROUNDED_NEWS\""
}
