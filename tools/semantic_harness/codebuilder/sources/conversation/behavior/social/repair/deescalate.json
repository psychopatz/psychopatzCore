{
  "schema": "psychopatz.psdl.v2",
  "profile": "social_behavior",
  "id": "behavior.deescalate",
  "act": "DEESCALATE",
  "baseRelevance": 0.35,
  "modifiers": [
    {
      "delta": 0.4,
      "reason": "fear_favors_deescalation",
      "when": "actor.condition.panic >= 0.6"
    },
    {
      "delta": 0.2,
      "reason": "danger_favors_deescalation",
      "when": "world.immediateDanger"
    }
  ],
  "outputs": {
    "speech": {
      "contentTemplateID": "interaction.argument.deescalate",
      "dialogueAct": "DEESCALATE"
    }
  },
  "when": "stimulus.semantic.speechAct in [\"INSULT\", \"HOSTILE_REMARK\", \"THREATEN\"] || world.immediateDanger"
}
