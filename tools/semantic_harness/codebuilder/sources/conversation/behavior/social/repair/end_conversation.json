{
  "schema": "psychopatz.convo-engine.v1",
  "profile": "social_behavior",
  "id": "behavior.end_conversation",
  "act": "END_INTERACTION",
  "baseRelevance": 0.2,
  "modifiers": [
    {
      "delta": 0.3,
      "reason": "danger_favors_exit",
      "when": "world.immediateDanger"
    },
    {
      "delta": 0.45,
      "reason": "low_forgiveness_favors_exit",
      "when": "actor.disposition.forgiveness < 0.25"
    }
  ],
  "outputs": {
    "speech": {
      "contentTemplateID": "social.hostile_withdrawn",
      "dialogueAct": "END_CONVERSATION"
    }
  },
  "when": "stimulus.semantic.speechAct in [\"INSULT\", \"HOSTILE_REMARK\", \"THREATEN\"] || stimulus.semantic.intent == \"APOLOGIZE\" || world.immediateDanger"
}
