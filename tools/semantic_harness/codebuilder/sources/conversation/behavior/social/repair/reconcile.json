{
  "schema": "psychopatz.convo-engine.v1",
  "profile": "social_behavior",
  "id": "behavior.reconcile",
  "act": "RECONCILE",
  "baseRelevance": 0.6,
  "modifiers": [
    {
      "delta": 0.15,
      "reason": "relationship_recoverable",
      "when": "relationship.approval >= -20"
    },
    {
      "delta": -0.2,
      "reason": "low_forgiveness",
      "when": "actor.disposition.forgiveness < 0.35"
    }
  ],
  "outputs": {
    "speech": {
      "contentTemplateID": "social.apology.friendly",
      "dialogueAct": "RECONCILE"
    }
  },
  "when": "stimulus.semantic.intent == \"APOLOGIZE\" && pragmatic.contextualAdmission.admitted"
}
