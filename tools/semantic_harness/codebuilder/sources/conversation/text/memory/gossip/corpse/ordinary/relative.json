        },
        {
          "key": "corpse.relative.04",
          "text": {
            "EN": "I'll carry you with me, {subject}. I promise.",
            "TL": "Dadalahin kita sa alaala ko, {subject}. Pangako."
          }
        },
        {
          "key": "corpse.relative.05",
          "text": {
