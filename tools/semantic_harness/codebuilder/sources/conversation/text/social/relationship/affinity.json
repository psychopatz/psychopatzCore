        },
        {
          "key": "opening",
          "text": {
            "EN": "I'm listening, {playerFirstName}. Say what you need to say.",
            "TL": "Nakikinig ako, {playerFirstName}. Sabihin ang kailangan mong sabihin."
          }
        },
        {
          "key": "response.us",
          "text": {
            "EN": "Yes. We probably should.",
            "TL": "Oo. Malamang dapat nga."
          }
        }
      ]
