          "key": "choice.ceasefire",
          "text": {
            "EN": "Ceasefire. Stand down for now.",
            "TL": "Ceasefire. Tumayo sa ngayon."
          }
        },
        {
          "key": "opening",
          "text": {
            "EN": "The survivor watches you carefully, ready to fight.",
            "TL": "Maingat kang pinagmamasdan ng survivor, handang lumaban."
          }
        },
        {
          "key": "response.ceasefire",
          "text": {
            "EN": "You ask for a short ceasefire.",
            "TL": "Humihingi ka ng maikling tigil-putukan."
          }
        },
        {
          "key": "result.accepted",
          "text": {
            "EN": "Ceasefire accepted for one hour.",
            "TL": "Tinanggap ang tigil-putukan sa loob ng isang oras."
          }
        },
        {
          "key": "result.rejected",
          "text": {
            "EN": "Ceasefire refused.",
            "TL": "Tumanggi ang tigil-putukan."
          }
        }
      ]
    }
  ]
