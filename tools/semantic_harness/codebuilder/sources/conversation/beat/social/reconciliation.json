{
  "schema": "psychopatz.psdl.v2",
  "profile": "social_beat",
  "id": "beat.reconciliation",
  "baseRelevance": 0.85,
  "candidates": {
    "behavior.reconcile": 0.65,
    "behavior.warn": 0.3,
    "behavior.end_conversation": 0.15
  },
  "cooldownTurns": 4,
  "entry": "stimulus.semantic.intent == \"APOLOGIZE\" && pragmatic.contextualAdmission.admitted && pragmatic.contextualAdmission.selected.relation == \"repair\"",
  "exit": "beat.turnsInBeat >= 2 || scene.ended || world.immediateDanger",
  "group": "beat_group.social_primary",
  "maintain": {
    "op": "falsy",
    "path": "scene.ended"
  },
  "maxTurns": 2
}
