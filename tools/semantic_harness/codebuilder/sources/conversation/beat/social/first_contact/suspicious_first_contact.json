{
  "schema": "psychopatz.psdl.v2",
  "profile": "social_beat",
  "id": "beat.suspicious_first_contact",
  "baseRelevance": 0.55,
  "candidates": {
    "behavior.challenge": 0.6,
    "behavior.warn": 0.45,
    "behavior.deescalate": 0.35
  },
  "cooldownTurns": 2,
  "entry": "scene.firstContact && relationship.familiarity <= 0 && stimulus.semantic.intent == \"GREET\"",
  "exit": "beat.turnsInBeat >= 3 || scene.ended || world.immediateDanger",
  "group": "beat_group.social_primary",
  "maintain": {
    "op": "falsy",
    "path": "scene.ended"
  },
  "maxTurns": 3
}
